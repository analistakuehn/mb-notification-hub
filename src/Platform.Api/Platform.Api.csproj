<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotificationHub.Api</RootNamespace>
    <AssemblyName>NotificationHub.Api</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <UserSecretsId>4f0f3676-a1b6-5a57-9b8c-b9c6b6517ec9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup Label="Project Packages">
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup Label="Test Visibility">
    <InternalsVisibleTo Include="NotificationHub.ArchTests" />
    <InternalsVisibleTo Include="NotificationHub.SecurityArchTests" />
    <InternalsVisibleTo Include="NotificationHub.UnitTests" />
    <InternalsVisibleTo Include="NotificationHub.IntegrationTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup Label="Araia Transports">
      <PackageReference Include="Asp.Versioning.Http" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>
  <ItemGroup Label="Araia Persistence">
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

  <ItemGroup Label="Araia Cache">
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
      <PackageReference Include="StackExchange.Redis" />
    </ItemGroup>

</Project>
