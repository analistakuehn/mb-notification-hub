{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Worker": {
    "Role": ""
  },
  "Platform": {
    "Messaging": {
      "Ef": {
        "ConnectionString": "Host=localhost;Port=5432;Database=NotificationHub_TemplateManagement;Username=postgres"
      },
      "Kafka": {
        "BootstrapServers": ""
      },
      "KafkaConsumer": {
        "BootstrapServers": ""
      }
    }
  },
  "Modules": {
    "Notifications": {
      "Persistence": {
        "Ef": {
          "ConnectionString": "Host=localhost;Port=5432;Database=NotificationHub_TemplateManagement;Username=postgres"
        }
      },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "KeyPrefix": "NotificationHub:Notifications:"
      },
      "CoreWorker": {
        "Bands": []
      },
      "Dispatcher": {
        "Channels": [],
        "Bands": []
      },
      "RenderedContentRetention": {
        "Enabled": true
      },
      "RenderedContentBackfill": {
        "Enabled": false
      },
      "DeliveryTracking": {
        "UnresolvedAttemptWindow": "00:05:00",
        "UnresolvedAttemptRetryDelay": "00:00:20"
      },
      "SchedulerScan": {
        "Enabled": true,
        "Interval": "00:00:05",
        "BatchSize": 200,
        "UnknownGrace": "00:01:00",
        "FallbackRequestRetry": "00:05:00"
      },
      "ProviderEventDedupePurge": {
        "Enabled": true,
        "Retention": "30.00:00:00"
      },
      "ProducerRegistry": {
        "CacheTtlSeconds": 60
      },
      "KafkaIngress": {
        "Bindings": [
          {
            "Topic": "notifications.requested.kyc.v1",
            "LogicalProducer": "kyc-service"
          },
          {
            "Topic": "notifications.requested.billing.v1",
            "LogicalProducer": "billing-service"
          }
        ],
        "DeadLetterTopic": "notifications.requested.dlt",
        "ConsumerGroup": "notification-hub-ingress"
      }
    },
    "Dispatch": {
      "Persistence": {
        "Ef": {
          "ConnectionString": "Host=localhost;Port=5432;Database=NotificationHub_TemplateManagement;Username=postgres"
        }
      }
    },
    "ContactConsent": {
      "Persistence": {
        "Ef": {
          "ConnectionString": "Host=localhost;Port=5432;Database=NotificationHub_TemplateManagement;Username=postgres"
        }
      },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "KeyPrefix": "NotificationHub:ContactConsent:"
      },
      "KafkaIngress": {
        "ContactsTopic": "contacts.events.v1",
        "DeadLetterTopic": "contacts.events.dlt",
        "ConsumerGroup": "notification-hub-contacts-ingress",
        "AcceptedSources": []
      }
    },
    "Audit": {
      "Persistence": {
        "Ef": {
          "ConnectionString": "Host=localhost;Port=5432;Database=NotificationHub_TemplateManagement;Username=postgres"
        }
      },
      "PartitionManager": {
        "EnableRevokeOnClosedPartitions": false,
        "EnableRetentionCycle": false,
        "EnableDropDetachedPartitions": false
      },
      "ChainVerification": {
        "Enabled": true
      },
      "WormExport": {
        "Bucket": "",
        "KeyPrefix": "audit-export/v1"
      }
    },
    "TemplateManagement": {
      "Persistence": {
        "Ef": {
          "ConnectionString": "Host=localhost;Port=5432;Database=NotificationHub_TemplateManagement;Username=postgres"
        }
      }
    }
  }
}
