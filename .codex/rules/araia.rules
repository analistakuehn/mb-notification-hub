# Generated by gen-harness-bundle.py from shared/command-policy.json.
# Regenerated on every `$araia sync --harness codex`. Edit the JSON
# source, not this file. See shared/command-policy.md.
#
# Content-rules are enforced separately by the generated PreToolUse
# hook because prefix_rule() cannot match a token at any position.
# See shared/command-policy.md.

prefix_rule(
    pattern=["git", "push", "--force"],
    decision="prompt",
    justification="Force-pushes rewrite remote history; git-hygiene-protocol.md Rule 2 forbids raw --force against protected branches and prefers --force-with-lease, which this rule deliberately excludes.",
)

prefix_rule(
    pattern=["git", "add", "-A"],
    decision="prompt",
    justification="Blind wildcard staging risks pulling in .env, credentials, build artifacts, or in-progress work not meant for this commit.",
)

prefix_rule(
    pattern=["git", "add", "."],
    decision="prompt",
    justification="Same risk as -A: stages every change under the current directory unreviewed.",
)

prefix_rule(
    pattern=["git", "reset", "--hard"],
    decision="prompt",
    justification="Discards working-tree and index changes irreversibly.",
)

prefix_rule(
    pattern=["git", "rebase"],
    decision="prompt",
    justification="Rewrites local history; risky when the affected commits already exist on a remote. A static rule cannot check push status, so this is a conservative blanket approximation of Rule 2's actual (published-commits-only) condition.",
)

prefix_rule(
    pattern=["git", "commit", "--amend"],
    decision="prompt",
    justification="Rewrites the previous commit; risky when it already exists on a remote. Same conservative-blanket caveat as rebase above.",
)

prefix_rule(
    pattern=["git", "cherry-pick"],
    decision="prompt",
    justification="Named in the protocol's Scope section as a history-rewriting risk when applied onto a published branch. Same conservative-blanket caveat: a static rule cannot check the target branch.",
)
