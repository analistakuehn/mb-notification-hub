{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process');let r=process.cwd();try{r=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||r}catch{}const p=require('node:path').join(r,'.codex/hooks/post-write-language-check.mjs');const s=spawnSync(process.execPath,[p,'--araia-hook-sha=5d711c7b7344'],{stdio:'inherit'});process.exit(s.status??0)\"",
            "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process');let r=process.cwd();try{r=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||r}catch{}const p=require('node:path').join(r,'.codex/hooks/post-write-language-check.mjs');const s=spawnSync(process.execPath,[p,'--araia-hook-sha=5d711c7b7344'],{stdio:'inherit'});process.exit(s.status??0)\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process');let r=process.cwd();try{r=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||r}catch{}const p=require('node:path').join(r,'.codex/hooks/post-write-tier-check.mjs');const s=spawnSync(process.execPath,[p,'--araia-hook-sha=388e6bc620a7'],{stdio:'inherit'});process.exit(s.status??0)\"",
            "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process');let r=process.cwd();try{r=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||r}catch{}const p=require('node:path').join(r,'.codex/hooks/post-write-tier-check.mjs');const s=spawnSync(process.execPath,[p,'--araia-hook-sha=388e6bc620a7'],{stdio:'inherit'});process.exit(s.status??0)\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process');let r=process.cwd();try{r=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||r}catch{}const p=require('node:path').join(r,'.codex/hooks/pre-bash-git-hygiene-check.mjs');const s=spawnSync(process.execPath,[p,'--araia-hook-sha=47b11b3d9177'],{stdio:'inherit'});process.exit(s.status??0)\"",
            "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process');let r=process.cwd();try{r=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||r}catch{}const p=require('node:path').join(r,'.codex/hooks/pre-bash-git-hygiene-check.mjs');const s=spawnSync(process.execPath,[p,'--araia-hook-sha=47b11b3d9177'],{stdio:'inherit'});process.exit(s.status??0)\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
