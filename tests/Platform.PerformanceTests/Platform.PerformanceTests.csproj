<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotificationHub.PerformanceTests</RootNamespace>
    <AssemblyName>NotificationHub.PerformanceTests</AssemblyName>
    <OutputType>Exe</OutputType>

    <!--
      Same collector the API declares. A measurement taken under the workstation
      collector answers about a process nobody operates: server GC gives one
      heap and one background thread per core, which is exactly the axis an
      allocation comparison between transfer methods lives on.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup Label="Collector Topology">
    <!--
      One heap, because the deployment target is a container of one processor.
      The mode alone does not describe a configuration: the server collector
      opens one heap per core unless a count is pinned, and the same arm
      measured against two heaps and against twenty-two answers with latencies
      that differ by more than most regressions a gate is meant to catch. A
      reference recorded here is only reproducible elsewhere because the count
      travels with it.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="1" />
  </ItemGroup>

  <ItemGroup Label="Test Visibility">
    <InternalsVisibleTo Include="NotificationHub.IntegrationTests" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\src\Platform.Api\Platform.Api.csproj" />
  </ItemGroup>

  <ItemGroup Label="Probe Infrastructure">
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup Label="Versioned Baseline">
    <!-- Not copied to the output on purpose. The gate reads and rewrites the
         file that is versioned, and a copy in the output directory would let a
         run compare against, or write to, a stale duplicate. -->
    <None Include="baselines\audit-chain-contention.json" />
    <None Include="baselines\published-read-memoization.json" />
    <None Include="baselines\published-render-cost.json" />
    <None Include="baselines\scriban-parse-memoization.json" />
    <None Include="baselines\attachment-transfer-method.json" />
    <None Include="baselines\provider-transfer.json" />
  </ItemGroup>

</Project>
