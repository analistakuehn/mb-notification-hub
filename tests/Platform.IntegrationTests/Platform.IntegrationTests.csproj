<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotificationHub.IntegrationTests</RootNamespace>
    <AssemblyName>NotificationHub.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\src\Platform.Api\Platform.Api.csproj" />
    <ProjectReference Include="..\..\src\Platform.Worker\Platform.Worker.csproj" />
    <ProjectReference Include="..\..\tools\Platform.GoLiveChecks\Platform.GoLiveChecks.csproj" />
  </ItemGroup>

  <!--
    The performance probe is referenced, not started, so its harness types can
    be driven by real tests. The metadata below points at the probe's own build
    output, which is where its runtime configuration lives: the collector a
    measurement runs under is a property of that file and of nothing else.
  -->
  <ItemGroup Label="Performance Harness">
    <ProjectReference Include="..\Platform.PerformanceTests\Platform.PerformanceTests.csproj" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PerformanceProbeDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../Platform.PerformanceTests/bin/$(Configuration)/$(TargetFramework)/</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Label="Implicit Usings">
    <Using Include="Microsoft.AspNetCore.Mvc.Testing" />
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Label="Test Framework">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.LocalStack" />
    <PackageReference Include="Testcontainers.Kafka" />
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

</Project>
