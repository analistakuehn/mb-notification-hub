<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotificationHub.UnitTests</RootNamespace>
    <AssemblyName>NotificationHub.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\src\Platform.Api\Platform.Api.csproj" />
    <ProjectReference Include="..\..\tools\Platform.GoLiveChecks\Platform.GoLiveChecks.csproj" />
  </ItemGroup>

  <!--
    The probe is started as a process and never loaded as an assembly, so the
    reference exists to build it and to hand its location to the test that runs
    it. Composing the path here keeps the configuration and the framework the
    test project was built with, instead of guessing them at run time.
  -->
  <ItemGroup Label="Out Of Process Probe">
    <ProjectReference Include="..\Platform.StackProbe\Platform.StackProbe.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StackProbeDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../Platform.StackProbe/bin/$(Configuration)/$(TargetFramework)/</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Label="Implicit Usings">
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Label="Test Framework">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" />
    <PackageReference Include="Bogus" />
  </ItemGroup>

</Project>
